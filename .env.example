# ---- Obligatorias en producción ----
SECRET_KEY=cambie-esto-por-un-valor-aleatorio-largo
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
# ---- Opcionales ----
GEMINI_MODEL=gemini-2.5-flash   # o gemini-2.5-pro (más riguroso, más lento)
OPENALEX_API_KEY=          # https://openalex.org/settings/api  (obligatoria desde feb-2026; gratis)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash   # si su cuenta no tiene acceso a Gemini 2.5
ANTHROPIC_API_KEY=         # https://console.anthropic.com  (activa el motor Claude)
CLAUDE_MODEL=claude-sonnet-5   # o claude-haiku-4-5-20251001 (más rápido/económico) / claude-opus-5-5
CLAUDE_TIMEOUT=25
SERPER_API_KEY=            # https://serper.dev  (Google Scholar + búsqueda web de frase exacta)
SEMANTIC_SCHOLAR_API_KEY=  # https://www.semanticscholar.org/product/api
CONTACT_EMAIL=tu-correo@dominio.com   # "polite pool" de OpenAlex / Crossref
API_KEYS=                  # claves separadas por coma para /api/v1 (vacío = API abierta)
CORS_ORIGINS=              # orígenes permitidos separados por coma, o *
RATE_LIMIT_PER_MIN=20
MAX_TEXT_CHARS=80000
MAX_UPLOAD_MB=15
REWRITE_MAX_PER_REQUEST=5      # oraciones por petición de reescritura
REWRITE_BATCH_SIZE=4           # oraciones por llamada a Gemini
REWRITE_TIME_BUDGET=20         # segundos máximos por petición de reescritura
AUDIT_GEMINI_BUDGET=22         # segundos máximos de la capa semántica en /audit
GEMINI_TIMEOUT=25
FLASK_ENV=development
PROJECTS_DB_PATH=data/projects.sqlite3   # SQLite de proyectos (use un disco persistente en Render)
PROJECT_MAX_BYTES=4194304
